NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:55432/nexus
REDIS_URL=redis://localhost:6379
# Generate each secret separately. Never use sample values in production.
# SESSION_SECRET and OTP_PEPPER: openssl rand -hex 48
# DATA_ENCRYPTION_KEY: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-48-random-characters-before-running
OTP_PEPPER=replace-with-a-different-48-random-character-secret
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
SESSION_TTL_HOURS=12
ADMIN_MFA_MAX_AGE_MINUTES=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=noreply@vml.example
# SMTP_USER=
# SMTP_PASSWORD=
# Google OAuth web client credentials; keep the real secret in .env only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nexus-private
S3_ACCESS_KEY=nexus-local
S3_SECRET_KEY=nexus-local-change-me
S3_FORCE_PATH_STYLE=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
MAX_UPLOAD_MB=10
ENABLE_SWAGGER=true
DOCUMENT_RETENTION_DAYS=365
PRIVACY_NOTICE_VERSION=2026-11-01

# Optional live assessment interviewer (server-side secrets only).
AI_PROVIDER=disabled
AI_BASE_URL=https://your-ai-service.example/v1
AI_API_KEY=
AI_MODEL=
# AI_TIMEOUT_MS=90000
AI_TLS_MAX_VERSION=TLSv1.3
AI_REASONING_EFFORT=none
AI_MAX_OUTPUT_TOKENS=1024
# Ollama extension: keep the model loaded between interview turns.
AI_KEEP_ALIVE=30m
# Browser speech is development-friendly; compatible adapters use the endpoints below.
STT_PROVIDER=browser
# STT_BASE_URL=http://localhost:8000/v1
# STT_API_KEY=
# STT_MODEL=
# STT_LANGUAGE=en
TTS_PROVIDER=browser
# TTS_BASE_URL=http://localhost:8001/v1
# TTS_API_KEY=
# TTS_MODEL=
# TTS_VOICE=alloy
# MAX_AUDIO_MB=8
# MAX_AUDIO_SECONDS=180

# Frontend OAuth return origin and bounded upload resources.
FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_TOTAL_MB=30
MAX_CONCURRENT_UPLOADS=4
MAX_ACCOUNT_UPLOAD_MB=500
