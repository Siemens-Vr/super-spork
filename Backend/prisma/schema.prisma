generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ChallengePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum DocumentCategory {
  NATIONAL_ID
  PASSPORT
  BACHELOR
  MASTER
  PHD
  DIPLOMA
  TRANSCRIPT
  SHORT_COURSE
  INDUSTRY_CERTIFICATION
  PROFESSIONAL_REGISTRATION
  OTHER
}

enum VerificationStatus {
  UPLOADED
  UNDER_REVIEW
  ADDITIONAL_EVIDENCE_REQUIRED
  AUTHENTICATED
  REJECTED
  DISPUTED
}

enum VerificationMethod {
  MANUAL
  INSTITUTION_CONFIRMATION
  OFFICIAL_VERIFICATION
  AI_ASSISTED
}

enum ScanStatus {
  QUARANTINED
  CLEAN
  INFECTED
  FAILED
}

enum BookingStatus {
  SCHEDULED
  CANCELLED
  RESCHEDULED
  COMPLETED
  EXPIRED
  MISSED
}

enum AssessmentTargetStatus {
  DRAFT
  PREPARED
  IN_PROGRESS
  COMPLETED
}

enum RequirementScope {
  CORE
  INDUSTRY
  COMPANY
  COURSE
}

enum LearningStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model User {
  id              String              @id @default(uuid()) @db.Uuid
  email           String              @unique
  legalName       String
  phone           String?
  passwordHash    String?
  emailVerifiedAt DateTime?           @db.Timestamptz(3)
  status          AccountStatus       @default(ACTIVE)
  sessionVersion  Int                 @default(0)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  profile         ApplicantProfile?
  roles           UserRole[]
  identities      AuthIdentity[]
  challenges      AuthChallenge[]
  sessions        Session[]
  mfa             AdminMfaCredential?
  documents       Document[]

  bookings          AssessmentBooking[]
  reviews           DocumentVerification[]
  evidence          VerificationEvidence[]
  audits            AuditLog[]
  suggestions       CompanySuggestion[]
  assessmentTargets AssessmentTarget[]
  assessedAttempts  AssessmentAttempt[]    @relation("AttemptAssessor")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  name  String           @unique
  roles RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
}

model ApplicantProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  country            String   @default("KE")
  region             String?
  educationLevel     String?
  institution        String?
  discipline         String?
  professionalStatus String?
  graduationYear     Int?
  summary            String?
  consentVersion     String
  consentAt          DateTime @default(now()) @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

model AuthIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider  String
  subject   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, subject])
  @@unique([userId, provider])
}

model Session {
  sid       String   @id
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

// Purpose-bound challenges replace two near-identical verification/reset tables.
model AuthChallenge {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose    ChallengePurpose
  verifier   String
  attempts   Int              @default(0)
  expiresAt  DateTime         @db.Timestamptz(3)
  consumedAt DateTime?        @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose, createdAt])
}

model AdminMfaCredential {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  encryptedSecret String
  recoveryHashes  String[]
  enabledAt       DateTime? @db.Timestamptz(3)
  lastCounter     BigInt    @default(-1)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  resourceId String?
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([resourceId])
}

enum InstitutionType {
  UNIVERSITY
  COLLEGE
  TRAINING_INSTITUTE
  OTHER
}

model Institution {
  id         String             @id @default(uuid()) @db.Uuid
  name       String             @unique
  country    String             @default("KE")
  website    String?
  type       InstitutionType    @default(OTHER)
  offersTvet Boolean            @default(false)
  sourceUrl  String?
  aliases    InstitutionAlias[]
  active     Boolean            @default(true)
  documents  Document[]
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(3)

  @@index([type, active])
}

model InstitutionAlias {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String      @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String

  @@unique([institutionId, name])
}

// Identity and academic records share storage mechanics; category separates their states.
model Document {
  id                        String                          @id @default(uuid()) @db.Uuid
  applicantId               String                          @db.Uuid
  applicant                 User                            @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  category                  DocumentCategory
  title                     String
  courseName                String?
  certificationName         String?
  issuer                    String?
  institutionId             String?                         @db.Uuid
  institutionName           String?
  institution               Institution?                    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  issuedAt                  DateTime?                       @db.Timestamptz(3)
  expiresAt                 DateTime?                       @db.Timestamptz(3)
  encryptedCredentialNumber String?
  verificationUrl           String?
  storageKey                String                          @unique
  mimeType                  String
  size                      Int
  sha256                    String
  scanStatus                ScanStatus                      @default(QUARANTINED)
  status                    VerificationStatus              @default(UPLOADED)
  replacesId                String?                         @unique @db.Uuid
  replaces                  Document?                       @relation("DocumentVersions", fields: [replacesId], references: [id], onDelete: Restrict)
  replacement               Document?                       @relation("DocumentVersions")
  qualificationId           String?                         @db.Uuid
  qualification             Document?                       @relation("QualificationTranscripts", fields: [qualificationId], references: [id], onDelete: Restrict)
  transcripts               Document[]                      @relation("QualificationTranscripts")
  reviews                   DocumentVerification[]
  evidence                  VerificationEvidence[]
  history                   VerificationStatusHistory[]
  analysisJobs              DocumentAnalysisJob[]
  assessmentQualifications  AssessmentTargetQualification[]
  createdAt                 DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                        @updatedAt @db.Timestamptz(3)

  @@index([applicantId, category])
  @@index([qualificationId])
  @@index([scanStatus, status])
}

model DocumentVerification {
  id                String             @id @default(uuid()) @db.Uuid
  documentId        String             @db.Uuid
  document          Document           @relation(fields: [documentId], references: [id], onDelete: Restrict)
  reviewerId        String             @db.Uuid
  reviewer          User               @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  method            VerificationMethod
  outcome           VerificationStatus
  reason            String
  internalNotes     String?
  evidenceReference String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
}

model VerificationEvidence {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  authorId   String   @db.Uuid
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  note       String
  reference  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
}

model VerificationStatusHistory {
  id         String              @id @default(uuid()) @db.Uuid
  documentId String              @db.Uuid
  document   Document            @relation(fields: [documentId], references: [id], onDelete: Restrict)
  fromStatus VerificationStatus?
  toStatus   VerificationStatus
  actorId    String              @db.Uuid
  reason     String
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
}

model DocumentAnalysisJob {
  id             String   @id @default(uuid()) @db.Uuid
  documentId     String   @db.Uuid
  document       Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  serviceVersion String
  state          String   @default("NOT_REQUESTED")
  findings       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
}

model Industry {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @unique
  description String
  active      Boolean           @default(true)
  companies   CompanyIndustry[]
  jobRoles    JobRoleIndustry[]

  assessmentTargets     AssessmentTargetIndustry[]
  requirementFrameworks CompetencyFramework[]
  createdAt             DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @db.Timestamptz(3)
}

model Company {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @unique
  description String
  website     String?
  country     String            @default("KE")
  active      Boolean           @default(true)
  industries  CompanyIndustry[]

  assessmentTargets     AssessmentTargetCompany[]
  requirementFrameworks CompetencyFramework[]
  createdAt             DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @db.Timestamptz(3)
}

model CompanyIndustry {
  companyId  String   @db.Uuid
  industryId String   @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Restrict)

  @@id([companyId, industryId])
}

model CompanySuggestion {
  id             String   @id @default(uuid()) @db.Uuid
  applicantId    String   @db.Uuid
  applicant      User     @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  name           String
  website        String?
  status         String   @default("PENDING")
  decisionReason String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
}

model JobRole {
  id          String            @id @default(uuid()) @db.Uuid
  title       String            @unique
  description String
  active      Boolean           @default(true)
  industries  JobRoleIndustry[]

  frameworks        CompetencyFramework[]
  blueprints        AssessmentBlueprint[]
  assessmentTargets AssessmentTarget[]
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
}

model JobRoleIndustry {
  jobRoleId  String   @db.Uuid
  industryId String   @db.Uuid
  jobRole    JobRole  @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Restrict)

  @@id([jobRoleId, industryId])
}

model Competency {
  id                     String                  @id @default(uuid()) @db.Uuid
  code                   String                  @unique
  name                   String
  description            String
  frameworks             FrameworkCompetency[]
  assessmentRequirements AssessmentRequirement[]
}

model CompetencyFramework {
  id           String                @id @default(uuid()) @db.Uuid
  jobRoleId    String                @db.Uuid
  jobRole      JobRole               @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)
  version      Int
  title        String
  approved     Boolean               @default(false)
  scope        RequirementScope      @default(CORE)
  industryId   String?               @db.Uuid
  industry     Industry?             @relation(fields: [industryId], references: [id], onDelete: Restrict)
  companyId    String?               @db.Uuid
  company      Company?              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  courseName   String?
  competencies FrameworkCompetency[]
  blueprints   AssessmentBlueprint[]
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)

  @@unique([jobRoleId, version])
}

model FrameworkCompetency {
  frameworkId       String              @db.Uuid
  competencyId      String              @db.Uuid
  framework         CompetencyFramework @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  competency        Competency          @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  weight            Int
  requiredScore     Int                 @default(70)
  learningObjective String?
  learningResources String[]            @default([])

  @@id([frameworkId, competencyId])
}

model AssessmentBlueprint {
  id                            String                   @id @default(uuid()) @db.Uuid
  jobRoleId                     String                   @db.Uuid
  jobRole                       JobRole                  @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)
  frameworkId                   String                   @db.Uuid
  framework                     CompetencyFramework      @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  version                       Int
  title                         String
  durationMinutes               Int
  instructions                  String
  active                        Boolean                  @default(false)
  requiresAuthenticatedIdentity Boolean                  @default(false)
  requiresAuthenticatedAcademic Boolean                  @default(false)
  availability                  AssessmentAvailability[]
  bookings                      AssessmentBooking[]
  attempts                      AssessmentAttempt[]
  interactionPolicy             Json                     @default("{}")
  scenarios                     BlueprintScenario[]
  createdAt                     DateTime                 @default(now()) @db.Timestamptz(3)

  @@unique([jobRoleId, version])
}

model AssessmentAvailability {
  id                        String              @id @default(uuid()) @db.Uuid
  blueprintId               String              @db.Uuid
  blueprint                 AssessmentBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  startsAt                  DateTime            @db.Timestamptz(3)
  endsAt                    DateTime            @db.Timestamptz(3)
  capacity                  Int
  minNoticeMinutes          Int                 @default(60)
  maxHorizonDays            Int                 @default(90)
  cancellationNoticeMinutes Int                 @default(60)
  rescheduleLimit           Int                 @default(2)
  timezone                  String              @default("Africa/Nairobi")
  active                    Boolean             @default(true)
  slots                     AssessmentSlot[]
  createdAt                 DateTime            @default(now()) @db.Timestamptz(3)
}

model AssessmentSlot {
  id             String                 @id @default(uuid()) @db.Uuid
  availabilityId String                 @db.Uuid
  availability   AssessmentAvailability @relation(fields: [availabilityId], references: [id], onDelete: Restrict)
  startsAt       DateTime               @db.Timestamptz(3)
  endsAt         DateTime               @db.Timestamptz(3)
  bookings       AssessmentBooking[]

  @@unique([availabilityId, startsAt])
  @@index([startsAt])
}

model AssessmentBooking {
  id                String                        @id @default(uuid()) @db.Uuid
  applicantId       String                        @db.Uuid
  applicant         User                          @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  targetId          String?                       @db.Uuid
  target            AssessmentTarget?             @relation(fields: [targetId], references: [id], onDelete: Restrict)
  blueprintId       String                        @db.Uuid
  blueprint         AssessmentBlueprint           @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  slotId            String                        @db.Uuid
  slot              AssessmentSlot                @relation(fields: [slotId], references: [id], onDelete: Restrict)
  seat              Int
  status            BookingStatus                 @default(SCHEDULED)
  idempotencyKey    String
  rescheduleCount   Int                           @default(0)
  rescheduledFromId String?                       @unique @db.Uuid
  rescheduledFrom   AssessmentBooking?            @relation("BookingChain", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  rescheduledTo     AssessmentBooking?            @relation("BookingChain")
  events            AssessmentBookingEvent[]
  interaction       AssessmentInteractionSession?
  createdAt         DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                      @updatedAt @db.Timestamptz(3)

  @@unique([applicantId, idempotencyKey])
  @@index([slotId, status])
  @@index([applicantId, createdAt])
  @@index([targetId])
}

model AssessmentTarget {
  id             String                          @id @default(uuid()) @db.Uuid
  applicantId    String                          @db.Uuid
  applicant      User                            @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  jobRoleId      String                          @db.Uuid
  jobRole        JobRole                         @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)
  status         AssessmentTargetStatus          @default(DRAFT)
  industries     AssessmentTargetIndustry[]
  companies      AssessmentTargetCompany[]
  qualifications AssessmentTargetQualification[]
  attempt        AssessmentAttempt?
  bookings       AssessmentBooking[]
  lockedAt       DateTime?                       @db.Timestamptz(3)
  completedAt    DateTime?                       @db.Timestamptz(3)
  createdAt      DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                        @updatedAt @db.Timestamptz(3)

  @@index([applicantId, createdAt])
}

model AssessmentTargetIndustry {
  targetId   String           @db.Uuid
  industryId String           @db.Uuid
  rank       Int
  target     AssessmentTarget @relation(fields: [targetId], references: [id], onDelete: Restrict)
  industry   Industry         @relation(fields: [industryId], references: [id], onDelete: Restrict)

  @@id([targetId, industryId])
  @@unique([targetId, rank])
}

model AssessmentTargetCompany {
  targetId  String           @db.Uuid
  companyId String           @db.Uuid
  rank      Int
  target    AssessmentTarget @relation(fields: [targetId], references: [id], onDelete: Restrict)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([targetId, companyId])
  @@unique([targetId, rank])
}

model AssessmentTargetQualification {
  targetId   String           @db.Uuid
  documentId String           @db.Uuid
  target     AssessmentTarget @relation(fields: [targetId], references: [id], onDelete: Restrict)
  document   Document         @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([targetId, documentId])
}

model AssessmentAttempt {
  id              String                        @id @default(uuid()) @db.Uuid
  targetId        String                        @unique @db.Uuid
  target          AssessmentTarget              @relation(fields: [targetId], references: [id], onDelete: Restrict)
  blueprintId     String                        @db.Uuid
  blueprint       AssessmentBlueprint           @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  contextSnapshot Json
  requirements    AssessmentRequirement[]
  results         AssessmentCompetencyResult[]
  learningPlan    LearningPlan?
  startedAt       DateTime?                     @db.Timestamptz(3)
  completedAt     DateTime?                     @db.Timestamptz(3)
  assessorId      String?                       @db.Uuid
  assessor        User?                         @relation("AttemptAssessor", fields: [assessorId], references: [id], onDelete: Restrict)
  completionKey   String?
  completionHash  String?
  overallScore    Float?
  interaction     AssessmentInteractionSession?
  accommodation   AssessmentAccommodation?
  createdAt       DateTime                      @default(now()) @db.Timestamptz(3)
}

model AssessmentRequirement {
  id                String                      @id @default(uuid()) @db.Uuid
  attemptId         String                      @db.Uuid
  attempt           AssessmentAttempt           @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  competencyId      String                      @db.Uuid
  competency        Competency                  @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  code              String
  name              String
  description       String
  requiredScore     Int
  weight            Int
  sources           Json
  learningObjective String
  learningResources String[]                    @default([])
  result            AssessmentCompetencyResult?

  @@unique([attemptId, competencyId])
}

model AssessmentCompetencyResult {
  id            String                @id @default(uuid()) @db.Uuid
  attemptId     String                @db.Uuid
  attempt       AssessmentAttempt     @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  requirementId String                @unique @db.Uuid
  requirement   AssessmentRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  score         Int
  gap           Int
  evidence      String
  learningItem  LearningPlanItem?
}

model LearningPlan {
  id          String             @id @default(uuid()) @db.Uuid
  attemptId   String             @unique @db.Uuid
  attempt     AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  status      LearningStatus     @default(PENDING)
  items       LearningPlanItem[]
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  completedAt DateTime?          @db.Timestamptz(3)
}

model LearningPlanItem {
  id          String                     @id @default(uuid()) @db.Uuid
  planId      String                     @db.Uuid
  plan        LearningPlan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  resultId    String                     @unique @db.Uuid
  result      AssessmentCompetencyResult @relation(fields: [resultId], references: [id], onDelete: Restrict)
  priority    Int
  objective   String
  resources   String[]                   @default([])
  status      LearningStatus             @default(PENDING)
  completedAt DateTime?                  @db.Timestamptz(3)

  @@unique([planId, priority])
}

model AssessmentBookingEvent {
  id        String            @id @default(uuid()) @db.Uuid
  bookingId String            @db.Uuid
  booking   AssessmentBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  actorId   String            @db.Uuid
  action    String
  reason    String?
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
}

model NotificationOutbox {
  id               String    @id @default(uuid()) @db.Uuid
  encryptedPayload String?
  status           String    @default("PENDING")
  sentAt           DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime @db.Timestamptz(3)
}

model AssessmentScenario {
  id                 String              @id @default(uuid()) @db.Uuid
  code               String
  version            Int                 @default(1)
  title              String
  prompt             String
  evaluationCriteria String
  competencyIds      String[]            @db.Uuid
  maxFollowups       Int                 @default(2)
  approved           Boolean             @default(false)
  blueprints         BlueprintScenario[]
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([code, version])
}

model BlueprintScenario {
  blueprintId String              @db.Uuid
  scenarioId  String              @db.Uuid
  position    Int
  blueprint   AssessmentBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  scenario    AssessmentScenario  @relation(fields: [scenarioId], references: [id], onDelete: Restrict)

  @@id([blueprintId, scenarioId])
  @@unique([blueprintId, position])
}

model AssessmentAccommodation {
  id              String            @id @default(uuid()) @db.Uuid
  attemptId       String            @unique @db.Uuid
  attempt         AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  waiveCamera     Boolean           @default(false)
  waiveMicrophone Boolean           @default(false)
  allowText       Boolean           @default(false)
  reason          String
  approvedById    String            @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
}

model AssessmentInteractionSession {
  id                String                          @id @default(uuid()) @db.Uuid
  attemptId         String                          @unique @db.Uuid
  attempt           AssessmentAttempt               @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  bookingId         String                          @unique @db.Uuid
  booking           AssessmentBooking               @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  mode              String
  language          String                          @default("en")
  status            String                          @default("ACTIVE")
  policy            Json
  preflight         Json
  scenarios         Json
  leaseToken        String?                         @db.Uuid
  leaseExpiresAt    DateTime?                       @db.Timestamptz(3)
  pendingResponseId String?                         @db.Uuid
  messages          AssessmentConversationMessage[]
  responses         AssessmentResponse[]
  transcriptions    AssessmentTranscription[]
  speech            AssessmentSpeech[]
  events            AssessmentSessionEvent[]
  checkpoints       AssessmentGraphCheckpoint[]
  writes            AssessmentGraphWrite[]
  evaluation        Json?
  completedAt       DateTime?                       @db.Timestamptz(3)
  createdAt         DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                        @updatedAt @db.Timestamptz(3)
}

model AssessmentConversationMessage {
  id            String                       @id @db.Uuid
  sessionId     String                       @db.Uuid
  session       AssessmentInteractionSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  sequence      Int
  role          String
  text          String
  scenarioIndex Int
  createdAt     DateTime                     @default(now()) @db.Timestamptz(3)
  speech        AssessmentSpeech[]

  @@unique([sessionId, sequence])
}

model AssessmentResponse {
  id              String                       @id @default(uuid()) @db.Uuid
  sessionId       String                       @db.Uuid
  session         AssessmentInteractionSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  idempotencyKey  String
  payloadHash     String
  promptId        String                       @db.Uuid
  origin          String
  confirmedText   String
  transcriptionId String?                      @unique @db.Uuid
  transcription   AssessmentTranscription?     @relation(fields: [transcriptionId], references: [id], onDelete: Restrict)
  processedAt     DateTime?                    @db.Timestamptz(3)
  createdAt       DateTime                     @default(now()) @db.Timestamptz(3)

  @@unique([sessionId, idempotencyKey])
}

model AssessmentTranscription {
  id           String                       @id @default(uuid()) @db.Uuid
  sessionId    String                       @db.Uuid
  session      AssessmentInteractionSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  status       String
  provider     String
  model        String?
  language     String
  originalText String?
  durationMs   Int?
  byteLength   Int?
  response     AssessmentResponse?
  corrections  TranscriptCorrection[]
  createdAt    DateTime                     @default(now()) @db.Timestamptz(3)
}

model TranscriptCorrection {
  id              String                  @id @default(uuid()) @db.Uuid
  transcriptionId String                  @db.Uuid
  transcription   AssessmentTranscription @relation(fields: [transcriptionId], references: [id], onDelete: Restrict)
  originalText    String
  confirmedText   String
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
}

model AssessmentSpeech {
  id        String                        @id @default(uuid()) @db.Uuid
  sessionId String                        @db.Uuid
  session   AssessmentInteractionSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  messageId String                        @db.Uuid
  message   AssessmentConversationMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  provider  String
  status    String
  createdAt DateTime                      @default(now()) @db.Timestamptz(3)
}

model AssessmentSessionEvent {
  id        String                       @id @default(uuid()) @db.Uuid
  sessionId String                       @db.Uuid
  session   AssessmentInteractionSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  kind      String
  details   Json?
  createdAt DateTime                     @default(now()) @db.Timestamptz(3)
}

model AssessmentGraphCheckpoint {
  sessionId    String                       @db.Uuid
  session      AssessmentInteractionSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  namespace    String                       @default("")
  checkpointId String
  parentId     String?
  type         String
  data         Bytes
  metadataType String
  metadata     Bytes
  createdAt    DateTime                     @default(now()) @db.Timestamptz(3)

  @@id([sessionId, namespace, checkpointId])
}

model AssessmentGraphWrite {
  sessionId    String                       @db.Uuid
  session      AssessmentInteractionSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  namespace    String                       @default("")
  checkpointId String
  taskId       String
  taskPath     String                       @default("")
  idx          Int
  channel      String
  type         String
  data         Bytes

  @@id([sessionId, namespace, checkpointId, taskId, idx])
}
