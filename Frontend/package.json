{
  "name": "vml-nexus-portals",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:applicant",
    "dev:applicant": "npm --prefix app/applicant run dev",
    "dev:employer": "npm --prefix app/employer run dev",
    "dev:admin": "npm --prefix app/admin run dev",
    "dev:trainer": "npm --prefix app/trainer run dev",
    "check": "npm --prefix app/applicant run check && node --check server.mjs && npm run typecheck && npm run build",
    "test": "npm --prefix app/applicant test",
    "start": "node server.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
